 299:./Application/Src/application.c **** // scan for keys that is triggered:
 300:./Application/Src/application.c **** void loop_scan_keys(){
 301:./Application/Src/application.c ****     static uint32_t key_fall_block_until = 0;
 302:./Application/Src/application.c ****     uint32_t now = HAL_GetTick();
 303:./Application/Src/application.c **** 
 304:./Application/Src/application.c ****     // also check for small bullet
 305:./Application/Src/application.c ****     is_small_bullet = (bool)HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_6);
 306:./Application/Src/application.c **** 
 307:./Application/Src/application.c ****     if ((int32_t)(now - key_fall_block_until) < 0){
 308:./Application/Src/application.c ****         memset(Keys_pressed, 0, sizeof(Keys_pressed)); // block all negedge if last negedge was det
 309:./Application/Src/application.c ****         return;
 310:./Application/Src/application.c ****     }
 311:./Application/Src/application.c **** 
 312:./Application/Src/application.c ****     // read for pin PA3(0) PA4(1) PA5(2):
 313:./Application/Src/application.c ****     for (int index = 0; index < KEY_NUMBER; index++){
 314:./Application/Src/application.c ****         bool is_pressed = !HAL_GPIO_ReadPin(GPIOA, (uint16_t)(1U << (index + 3)));
 315:./Application/Src/application.c **** 
 316:./Application/Src/application.c ****         if (is_pressed && !Keys_pressed[index]){
 317:./Application/Src/application.c ****             wait_ms(DEBOUNCE_DELAY);
 318:./Application/Src/application.c ****             // after delay, if still pressed -> true else false
 319:./Application/Src/application.c ****             is_pressed = !HAL_GPIO_ReadPin(GPIOA, (uint16_t)(1U << (index + 3)));
 320:./Application/Src/application.c ****             if (is_pressed && !long_pressed[index]){
 321:./Application/Src/application.c ****                 key_fall_block_until = HAL_GetTick() + KEY_FALL_BLOCK_MS;
 322:./Application/Src/application.c ****                 key_need_handle = index;
 323:./Application/Src/application.c ****                 long_pressed[index] = 1;
 324:./Application/Src/application.c ****                 memset(Keys_pressed, 0, sizeof(Keys_pressed));
 325:./Application/Src/application.c ****                 return;
 326:./Application/Src/application.c ****             }
 327:./Application/Src/application.c ****         } else {
 328:./Application/Src/application.c ****             long_pressed[index] = 0;
 329:./Application/Src/application.c ****         }
 330:./Application/Src/application.c **** 
 331:./Application/Src/application.c ****         if (is_pressed){
 332:./Application/Src/application.c ****             Keys_pressed[index] = true;
 333:./Application/Src/application.c ****         } else {
 334:./Application/Src/application.c ****             Keys_pressed[index] = false;
 335:./Application/Src/application.c ****         }
 336:./Application/Src/application.c ****     }
 337:./Application/Src/application.c **** }
